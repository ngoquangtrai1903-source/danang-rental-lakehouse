# PostgreSQL local (requires PostgreSQL and PostGIS)
POSTGRES_DSN=postgresql+psycopg://postgres:replace-me@localhost:5432/rental_danang

# Cloudflare R2 Bronze bucket
R2_ENDPOINT_URL=https://replace-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=replace-bucket-name
R2_ACCESS_KEY_ID=replace-access-key-id
R2_SECRET_ACCESS_KEY=replace-secret-access-key
R2_REGION=auto
